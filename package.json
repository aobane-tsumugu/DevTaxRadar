{
  "name": "devtax-radar",
  "private": true,
  "version": "0.1.0",
  "description": "Allocate Claude Code and Codex subscriptions to explainable product costs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aobane-tsumugu/DevTaxRadar.git"
  },
  "homepage": "https://github.com/aobane-tsumugu/DevTaxRadar#readme",
  "bugs": {
    "url": "https://github.com/aobane-tsumugu/DevTaxRadar/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.ts\"",
    "preview": "vite preview --host 127.0.0.1",
    "preview:cloudflare": "npm run build && wrangler pages dev dist",
    "deploy:cloudflare": "npm run build && npm run privacy:check && wrangler pages deploy dist --project-name devtax-radar",
    "privacy:check": "tsx scripts/privacy-check.ts",
    "release:pack": "tsx scripts/package-release.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
